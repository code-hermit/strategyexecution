# Copy to .env (git-ignored) and fill in. TOTP secrets are the base32 keys shown when you
# enabled the authenticator app on each broker (the text under the QR code), not a 6-digit code.

# GitHub - fine-grained PAT with "Contents: read and write" on the repo
GITHUB_PAT=
GITHUB_REPO=code-hermit/strategyexecution
GITHUB_BRANCH=main
# Folder inside the repo for the token files; empty = repo root
GITHUB_DIR=

# Telegram summary after each run (same bot/chat as the trading scripts); leave empty to skip
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which brokers to log in to (comma separated). Leave unset to use the Dockerfile default
# (zerodha,aliceblue - finvasia disabled for now); add finvasia here to re-enable it.
# BROKERS=zerodha,aliceblue,finvasia

# Zerodha
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# AliceBlue
ALICEBLUE_USER_ID="AB036961"
ALICEBLUE_APP_SECRET=
ALICEBLUE_APP_CODE=4IxfSoqtdk
ALICEBLUE_PASSWORD=
ALICEBLUE_TOTP_SECRET=
# Only needed if the login page asks for an MPIN instead of / as well as TOTP
ALICEBLUE_MPIN=

# Finvasia (Shoonya) - must run from the static IP registered on the API key page
FINVASIA_CLIENT_ID=
FINVASIA_SECRET_CODE=
FINVASIA_USER_ID=
FINVASIA_PASSWORD=
FINVASIA_TOTP_SECRET=

# Optional: the redirect URL registered with each broker app. When set, only a navigation to
# this URL counts as the login finishing (otherwise any page carrying the code param does).
ZERODHA_REDIRECT_URL=
ALICEBLUE_REDIRECT_URL=
FINVASIA_REDIRECT_URL=

# LOGIN_TIMEOUT=90
